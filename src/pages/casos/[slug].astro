---
// /casos/<slug> — detalle de cada caso. Diseño y textos: src/views/CasoDetalle.astro + src/i18n/ui.ts
import CasoDetalle from '../../views/CasoDetalle.astro';
import { getCasosConRelacionados } from '../../lib/cms';

export async function getStaticPaths() {
  const casos = await getCasosConRelacionados('es');
  // Slug decodificado para que Astro matchee bien los caracteres especiales
  return casos.map(({ caso, related }) => ({
    params: { slug: decodeURIComponent(caso.slug) },
    props: { caso, related },
  }));
}

const { caso, related } = Astro.props;
---

<CasoDetalle lang="es" caso={caso} related={related} />
