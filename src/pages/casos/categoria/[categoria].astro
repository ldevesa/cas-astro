---
// /casos/categoria/<categoria> — una página por categoría. Diseño y textos: src/views/CasosCategoria.astro + src/i18n/ui.ts
import CasosCategoria from '../../../views/CasosCategoria.astro';
import { CATEGORIAS_CASO } from '../../../lib/cms';

export async function getStaticPaths() {
  return CATEGORIAS_CASO.map((categoria) => ({ params: { categoria } }));
}

const { categoria } = Astro.params;
---

<CasosCategoria lang="es" categoria={categoria!} />
