---
// /carreras/<slug> — detalle de cada búsqueda. Diseño y textos: src/views/CarreraDetalle.astro + src/i18n/ui.ts (careers)
import CarreraDetalle from '../../../views/CarreraDetalle.astro';
import { getCarreras } from '../../../lib/cms';

export async function getStaticPaths() {
  const carreras = await getCarreras('en');
  return carreras.map((carrera) => ({ params: { slug: carrera.slug }, props: { carrera } }));
}

const { carrera } = Astro.props;
---

<CarreraDetalle lang="en" carrera={carrera} />
