---
// /casos/N — páginas del listado. Diseño y textos: src/views/CasosListado.astro + src/i18n/ui.ts
import CasosListado from '../../../views/CasosListado.astro';
import { getCasosPage, CASOS_POR_PAGINA } from '../../../lib/cms';

export async function getStaticPaths() {
  const { totalPages } = await getCasosPage(1, CASOS_POR_PAGINA, 'en');
  return Array.from({ length: totalPages }, (_, i) => ({ params: { page: String(i + 1) } }));
}

const currentPage = parseInt(Astro.params.page, 10);
---

<CasosListado lang="en" currentPage={currentPage} conNumeroEnTitulo />
