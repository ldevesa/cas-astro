---
// Listado paginado de casos (/casos, /casos/N) — una sola vista para los 3 idiomas.
// Las páginas en src/pages/{,en/,pt/}casos/ solo la invocan con su idioma.
import Layout from '../layouts/Layout.astro';
import CasoCard from '../components/CasoCard.astro';
import Paginacion from '../components/Paginacion.astro';
import { getCasosPage, CASOS_POR_PAGINA, type Lang } from '../lib/cms';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  currentPage: number;
  /** /casos (página 1 sin número) vs /casos/N: solo cambia el título de la pestaña. */
  conNumeroEnTitulo: boolean;
}

const { lang, currentPage, conNumeroEnTitulo } = Astro.props;
const t = useTranslations(lang);
const { casos, total, totalPages } = await getCasosPage(currentPage, CASOS_POR_PAGINA, lang);

const title = conNumeroEnTitulo
  ? `${t.cases.title} — ${t.cases.pageTitle} ${currentPage} | CAS`
  : `${t.cases.title} | CAS`;
---

<Layout title={title} description={t.cases.metaDescription}>
  <section class="bg-[#131313] pt-32 pb-24">
    <div class="max-w-screen-2xl mx-auto px-8">

      <div class="mb-16">
        <p class="font-['Inter'] text-xs uppercase tracking-[0.35em] text-[#ffb876] mb-4">{t.cases.label}</p>
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
          <h1 class="font-['Space_Grotesk'] text-4xl md:text-6xl font-black tracking-tight text-white leading-[0.95]">{t.cases.title}</h1>
          <p class="font-['Inter'] text-xs uppercase tracking-[0.2em] text-gray-500">
            {total} {t.cases.works} · {t.cases.page} {currentPage} {t.cases.of} {totalPages}
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {casos.map((caso) => <CasoCard caso={caso} lang={lang} />)}
      </div>

      <Paginacion lang={lang} basePath="/casos" currentPage={currentPage} totalPages={totalPages} />

    </div>
  </section>
</Layout>
