---
// Detalle de una búsqueda (/carreras/<slug>) — una sola vista para los 3 idiomas. Textos en src/i18n/ui.ts (careers).
import Layout from '../layouts/Layout.astro';
import CarreraEtiquetas from '../components/CarreraEtiquetas.astro';
import { PortableText } from 'astro-portabletext';
import type { Carrera, Lang } from '../lib/cms';
import { useTranslations, getLocalePath } from '../i18n/utils';

interface Props {
  lang: Lang;
  carrera: Carrera;
}

const { lang, carrera } = Astro.props;
const t = useTranslations(lang);
const carrerasUrl = getLocalePath(lang, '/carreras');
---

<Layout
  title={`${carrera.titulo} | ${t.careers.detailTitleSuffix}`}
  description={`${t.careers.detailDescPrefix}: ${carrera.titulo}. ${carrera.areaTrabajo ?? ''} · ${carrera.tipo ?? ''}`}
>

  <!-- Header posición -->
  <section class="bg-[#0a0a0a] pt-16 pb-12 border-b border-white/5">
    <div class="max-w-screen-xl mx-auto px-8">

      <a href={carrerasUrl} class="inline-flex items-center gap-2 font-['Inter'] text-xs uppercase tracking-wider text-gray-500 hover:text-[#ffb876] transition-colors mb-12">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        {t.careers.back}
      </a>

      <div class="flex flex-wrap gap-2 mb-6">
        <CarreraEtiquetas carrera={carrera} lang={lang} />
      </div>

      <h1
        class="font-['Space_Grotesk'] font-black text-4xl md:text-6xl tracking-tight leading-[0.95] text-white"
      >{carrera.titulo}</h1>
    </div>
  </section>

  <!-- Contenido -->
  <section class="bg-[#131313] py-16">
    <div class="max-w-screen-xl mx-auto px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">

        <!-- Descripción del puesto -->
        <div class="lg:col-span-2">
          {carrera.contenido && (
            <div
              class="prose prose-invert prose-lg max-w-none
                prose-headings:font-['Space_Grotesk'] prose-headings:font-black prose-headings:tracking-tight
                prose-p:font-['Plus_Jakarta_Sans'] prose-p:text-gray-300 prose-p:leading-relaxed
                prose-li:font-['Plus_Jakarta_Sans'] prose-li:text-gray-300
                prose-strong:text-white prose-strong:font-bold
                prose-a:text-[#ffb876] prose-a:no-underline hover:prose-a:underline"
            >
              <PortableText value={carrera.contenido} />
            </div>
          )}
        </div>

        <!-- Sidebar: aplicar -->
        <aside class="lg:col-span-1">
          <div class="sticky top-28 bg-[#111111] border border-white/10 rounded-2xl p-8">
            <h3 class="font-['Space_Grotesk'] font-black text-xl text-white mb-2">{t.careers.interested}</h3>
            <p class="font-['Plus_Jakarta_Sans'] text-gray-400 text-sm mb-8 leading-relaxed">
              {t.careers.applyBody}
            </p>
            <a
              href={`mailto:rrhh@contenidosad.com?subject=${t.careers.mailSubject}: ${carrera.titulo}`}
              class="block text-center bg-[#F69220] text-white font-['Space_Grotesk'] font-black uppercase tracking-widest px-6 py-4 hover:brightness-110 transition-all duration-300 rounded-xl mb-4"
            >
              {t.careers.applyNow}
            </a>
            <a
              href={carrerasUrl}
              class="block text-center border border-white/10 text-gray-400 font-['Space_Grotesk'] font-bold uppercase tracking-wider text-sm px-6 py-3 hover:border-white/30 hover:text-white transition-all duration-300 rounded-xl"
            >
              {t.careers.viewAll}
            </a>
          </div>
        </aside>

      </div>
    </div>
  </section>

</Layout>

<style is:global>
  .prose ul { padding-left: 1.25rem; }
  .prose ul li { list-style-type: disc; }
  .prose ul li::marker { color: #F69220; }
  .prose h2 { font-size: 1.5rem; margin-top: 2.5rem; margin-bottom: 1rem; color: white; }
  .prose h3 { font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: white; }
  .prose p { margin-bottom: 1rem; }
  .prose strong u, .prose u strong { text-decoration: underline; color: white; }
</style>
